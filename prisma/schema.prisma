generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  TECHNICIAN
  EMPLOYEE
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum TicketType {
  INCIDENT
  SERVICE_REQUEST
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  TRIAGED
  IN_PROGRESS
  WAITING_REQUESTER
  WAITING_APPROVAL
  SCHEDULED
  RESOLVED
  CLOSED
  CANCELED
}

enum TicketSource {
  PORTAL
  EMAIL
  MANUAL
  API
}

enum CommentVisibility {
  PUBLIC
  INTERNAL
}

enum AssetStatus {
  IN_STOCK
  ASSIGNED
  IN_REPAIR
  RETIRED
  LOST
}

model Organization {
  id       String @id @default(cuid())
  name     String @db.VarChar(100)
  slug     String @unique @db.VarChar(80)
  timezone String @default("Asia/Jakarta") @db.VarChar(50)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  memberships Membership[]
  tickets     Ticket[]
  assets      Asset[]
}

model User {
  id        String  @id @default(cuid())
  name      String  @db.VarChar(100)
  email     String  @unique @db.VarChar(255)
  avatarUrl String? @db.VarChar(500)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  memberships      Membership[]
  requestedTickets Ticket[]        @relation("TicketRequester")
  assignedTickets  Ticket[]        @relation("TicketAssignee")
  assignedAssets   Asset[]         @relation("AssetAssignee")
  comments         TicketComment[]
  events           TicketEvent[]   @relation("TicketEventActor")
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole   @default(EMPLOYEE)
  status         MembershipStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role, status])
}

model Ticket {
  id             String         @id @default(cuid())
  organizationId String
  number         Int
  type           TicketType
  title          String         @db.VarChar(120)
  description    String         @db.Text
  priority       TicketPriority @default(NORMAL)
  status         TicketStatus   @default(OPEN)
  source         TicketSource   @default(PORTAL)
  category       String         @db.VarChar(80)

  requesterId String
  assigneeId  String?
  assetId     String?

  firstResponseDueAt DateTime? @db.Timestamptz(3)
  resolutionDueAt    DateTime? @db.Timestamptz(3)
  resolvedAt         DateTime? @db.Timestamptz(3)
  closedAt           DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester    User         @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee     User?        @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  asset        Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)

  comments TicketComment[]
  events   TicketEvent[]

  @@unique([organizationId, number])
  @@index([organizationId, status, priority])
  @@index([requesterId])
  @@index([assigneeId, status])
  @@index([assetId])
  @@index([createdAt])
}

model TicketComment {
  id         String            @id @default(cuid())
  ticketId   String
  authorId   String
  body       String            @db.Text
  visibility CommentVisibility @default(PUBLIC)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  editedAt  DateTime? @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([authorId])
}

model TicketEvent {
  id        String  @id @default(cuid())
  ticketId  String
  actorId   String?
  action    String  @db.VarChar(80)
  fromValue String? @db.VarChar(255)
  toValue   String? @db.VarChar(255)
  metadata  Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation("TicketEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([actorId])
}

model Asset {
  id             String      @id @default(cuid())
  organizationId String
  assignedToId   String?
  assetTag       String      @db.VarChar(50)
  name           String      @db.VarChar(120)
  type           String      @db.VarChar(80)
  status         AssetStatus @default(IN_STOCK)
  serialNumber   String?     @db.VarChar(120)
  manufacturer   String?     @db.VarChar(100)
  model          String?     @db.VarChar(120)

  purchaseDate      DateTime? @db.Date
  warrantyExpiresAt DateTime? @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("AssetAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  tickets Ticket[]

  @@unique([organizationId, assetTag])
  @@index([organizationId, status])
  @@index([assignedToId])
  @@index([serialNumber])
}
