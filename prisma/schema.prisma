generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  TECHNICIAN
  EMPLOYEE
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum TicketType {
  INCIDENT
  SERVICE_REQUEST
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  TRIAGED
  IN_PROGRESS
  WAITING_REQUESTER
  WAITING_APPROVAL
  SCHEDULED
  RESOLVED
  CLOSED
  CANCELED
}

enum TicketSource {
  PORTAL
  EMAIL
  MANUAL
  API
}

enum CommentVisibility {
  PUBLIC
  INTERNAL
}

enum NotificationType {
  TICKET_CREATED
  TICKET_ASSIGNED
  TICKET_STATUS_CHANGED
  TICKET_REPLY_ADDED
  TICKET_INTERNAL_NOTE_ADDED
}

enum KnowledgeArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssetStatus {
  IN_STOCK
  ASSIGNED
  IN_REPAIR
  RETIRED
  LOST
}

model Organization {
  id       String @id @default(cuid())
  name     String @db.VarChar(100)
  slug     String @unique @db.VarChar(80)
  timezone String @default("Asia/Jakarta") @db.VarChar(50)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  memberships          Membership[]
  tickets              Ticket[]
  assets               Asset[]
  serviceLevelPolicies ServiceLevelPolicy[]
  events               OrganizationEvent[]
  notifications        Notification[]
  knowledgeArticles    KnowledgeArticle[]
}

model User {
  id            String  @id @default(cuid())
  name          String  @db.VarChar(100)
  email         String  @unique @db.VarChar(255)
  emailVerified Boolean @default(false)
  avatarUrl     String? @db.VarChar(500)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  memberships               Membership[]
  requestedTickets          Ticket[]                @relation("TicketRequester")
  assignedTickets           Ticket[]                @relation("TicketAssignee")
  assignedAssets            Asset[]                 @relation("AssetAssignee")
  comments                  TicketComment[]
  events                    TicketEvent[]           @relation("TicketEventActor")
  assetEvents               AssetEvent[]            @relation("AssetEventActor")
  membershipEvents          MembershipEvent[]       @relation("MembershipEventActor")
  organizationEvents        OrganizationEvent[]     @relation("OrganizationEventActor")
  sessions                  Session[]
  accounts                  Account[]
  receivedNotifications     Notification[]          @relation("NotificationRecipient")
  sentNotifications         Notification[]          @relation("NotificationActor")
  authoredKnowledgeArticles KnowledgeArticle[]      @relation("KnowledgeArticleAuthor")
  knowledgeArticleEvents    KnowledgeArticleEvent[] @relation("KnowledgeArticleEventActor")
}

model ServiceLevelPolicy {
  id                   String         @id @default(cuid())
  organizationId       String
  priority             TicketPriority
  firstResponseMinutes Int
  resolutionMinutes    Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, priority])
  @@index([organizationId])
}

model OrganizationEvent {
  id             String  @id @default(cuid())
  organizationId String
  actorId        String?
  action         String  @db.VarChar(80)
  fromValue      Json?
  toValue        Json?
  metadata       Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("OrganizationEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId])
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique @db.VarChar(255)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  ipAddress String? @db.VarChar(64)
  userAgent String? @db.Text
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id         String @id
  issuer     String @db.VarChar(255)
  accountId  String @db.VarChar(255)
  providerId String @db.VarChar(100)
  userId     String

  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?   @db.Text
  password              String?   @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole   @default(EMPLOYEE)
  status         MembershipStatus @default(ACTIVE)
  department     String?          @db.VarChar(80)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  events       MembershipEvent[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role, status])
}

model MembershipEvent {
  id           String  @id @default(cuid())
  membershipId String
  actorId      String?
  action       String  @db.VarChar(80)
  fromValue    Json?
  toValue      Json?
  metadata     Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  actor      User?      @relation("MembershipEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([membershipId, createdAt])
  @@index([actorId])
}

model Ticket {
  id             String         @id @default(cuid())
  organizationId String
  number         Int
  type           TicketType
  title          String         @db.VarChar(120)
  description    String         @db.Text
  priority       TicketPriority @default(NORMAL)
  status         TicketStatus   @default(OPEN)
  source         TicketSource   @default(PORTAL)
  category       String         @db.VarChar(80)

  requesterId String
  assigneeId  String?
  assetId     String?

  firstResponseDueAt DateTime? @db.Timestamptz(3)
  firstRespondedAt   DateTime? @db.Timestamptz(3)
  resolutionDueAt    DateTime? @db.Timestamptz(3)
  resolvedAt         DateTime? @db.Timestamptz(3)
  closedAt           DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester    User         @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee     User?        @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  asset        Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)

  comments TicketComment[]
  events   TicketEvent[]

  notifications Notification[]

  @@unique([organizationId, number])
  @@index([organizationId, status, priority])
  @@index([requesterId])
  @@index([assigneeId, status])
  @@index([assetId])
  @@index([createdAt])
  @@index([organizationId, firstRespondedAt])
}

model TicketComment {
  id         String            @id @default(cuid())
  ticketId   String
  authorId   String
  body       String            @db.Text
  visibility CommentVisibility @default(PUBLIC)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  editedAt  DateTime? @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([authorId])
}

model TicketEvent {
  id        String  @id @default(cuid())
  ticketId  String
  actorId   String?
  action    String  @db.VarChar(80)
  fromValue String? @db.VarChar(255)
  toValue   String? @db.VarChar(255)
  metadata  Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation("TicketEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([actorId])
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  recipientId    String
  actorId        String?
  ticketId       String?
  type           NotificationType
  title          String           @db.VarChar(120)
  body           String           @db.VarChar(255)
  readAt         DateTime?        @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient    User         @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor        User?        @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  ticket       Ticket?      @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([organizationId, recipientId, readAt, createdAt])
  @@index([ticketId])
  @@index([actorId])
}

model KnowledgeArticle {
  id             String                 @id @default(cuid())
  organizationId String
  authorId       String
  title          String                 @db.VarChar(120)
  summary        String                 @db.VarChar(240)
  content        String                 @db.Text
  category       String                 @db.VarChar(80)
  tags           String[]               @default([])
  status         KnowledgeArticleStatus @default(DRAFT)
  publishedAt    DateTime?              @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User                    @relation("KnowledgeArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  events       KnowledgeArticleEvent[]

  @@index([organizationId, status, updatedAt])
  @@index([organizationId, category])
  @@index([authorId])
}

model KnowledgeArticleEvent {
  id        String  @id @default(cuid())
  articleId String
  actorId   String?
  action    String  @db.VarChar(80)
  fromValue Json?
  toValue   Json?
  metadata  Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  actor   User?            @relation("KnowledgeArticleEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([articleId, createdAt])
  @@index([actorId])
}

model Asset {
  id             String      @id @default(cuid())
  organizationId String
  assignedToId   String?
  assetTag       String      @db.VarChar(50)
  name           String      @db.VarChar(120)
  type           String      @db.VarChar(80)
  status         AssetStatus @default(IN_STOCK)
  serialNumber   String?     @db.VarChar(120)
  manufacturer   String?     @db.VarChar(100)
  model          String?     @db.VarChar(120)

  purchaseDate      DateTime? @db.Date
  warrantyExpiresAt DateTime? @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("AssetAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  tickets Ticket[]
  events  AssetEvent[]

  @@unique([organizationId, assetTag])
  @@index([organizationId, status])
  @@index([assignedToId])
  @@index([serialNumber])
}

model AssetEvent {
  id        String  @id @default(cuid())
  assetId   String
  actorId   String?
  action    String  @db.VarChar(80)
  fromValue String? @db.VarChar(255)
  toValue   String? @db.VarChar(255)
  metadata  Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  actor User? @relation("AssetEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([assetId, createdAt])
  @@index([actorId])
}
